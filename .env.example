# Supabase — proyecto (URL y llaves) que la Alcaldía debe crear.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme
# Nunca exponer al cliente. Solo se usa en rutas API (server-side).
SUPABASE_SERVICE_ROLE_KEY=changeme

# Nombre del bucket de Supabase Storage para fotos/video de evidencias
SUPABASE_EVIDENCIAS_BUCKET=evidencias-viviendas

# Prefijo del código de radicado, ej. JAM-2026-000123
CODIGO_RADICADO_PREFIJO=JAM-2026
